# Export variables explicitly; Phase 0 does not automatically read .env files.
# Relative path overrides are resolved against --project-root.
# DIETARY_RAG_DATA_DIR=data
# DIETARY_RAG_SOURCE_REGISTRY=config/sources.yaml
# DIETARY_RAG_LOG_LEVEL=INFO
# DIETARY_RAG_MODEL_PROVIDER=hosted
# DIETARY_RAG_MODEL_NAME=your-configured-model
# Credentials are reserved for later provider adapters and never printed by check-settings.
# DIETARY_RAG_MODEL_API_KEY=replace-locally
